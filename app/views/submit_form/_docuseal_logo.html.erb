<% account = @template&.account || @submitter&.account || @submission&.account %>
<% logo = Accounts.load_logo(account) %>
<% if logo %>
  <div class="mx-auto text-2xl md:text-3xl font-bold items-center flex space-x-3 min-w-0">
    <%= render 'start_form/account_logo', logo:, account:, class: 'h-9 md:h-12 max-w-[8rem] w-auto object-contain' %>
    <span class="truncate"><%= account.name %></span>
  </div>
<% else %>
  <a href="<%= root_path %>" class="mx-auto text-2xl md:text-3xl font-bold items-center flex space-x-3">
    <%= render 'shared/logo', class: 'w-9 h-9 md:w-12 md:h-12' %>
    <span><%= Docuseal.product_name %></span>
  </a>
<% end %>
