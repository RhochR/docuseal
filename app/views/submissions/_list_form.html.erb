<% submitters = template.submitters.reject { |e| e['invite_by_uuid'].present? || e['optional_invite_by_uuid'].present? || e['invite_via_field_uuid'].present? } %>
<% submitter_uuids = submitters.pluck('uuid') %>
<% import_template = { name: template.name, submitters: submitters.map { |s| s.slice('uuid', 'name') }, fields: template.fields.select { |f| submitter_uuids.include?(f['submitter_uuid']) }.map { |f| f.slice('uuid', 'submitter_uuid', 'name', 'type') } } %>
<%= form_for '', url: template_submissions_import_path(template), html: { class: 'space-y-4', autocomplete: 'off' }, data: { turbo_frame: :_top } do |f| %>
  <import-list class="block" data-template="<%= import_template.to_json %>" data-i18n="<%= t('import_list').to_json %>"></import-list>
  <div id="list_form_buttons" class="hidden space-y-4">
    <div>
      <%= render('submitters_order', f:, template:) if can_send_emails %>
      <%= render 'send_email', f:, template:, can_send_emails:, viewer_submitter_uuids: local_assigns[:viewer_submitter_uuids] %>
    </div>
    <div class="form-control">
      <%= f.button button_title(title: t('add_recipients')), class: 'base-button' %>
    </div>
  </div>
<% end %>
