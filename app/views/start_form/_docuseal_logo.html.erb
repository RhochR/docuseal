<% account = @template&.account || @submitter&.account || @submission&.account %>
<% logo = Accounts.load_logo(account) %>
<% if logo %>
  <div class="flex justify-center items-center">
    <%= render 'start_form/account_logo', logo:, account:, class: 'mr-3 max-h-14 max-w-[10rem] w-auto object-contain' %>
    <h1 class="text-2xl md:text-4xl font-bold text-center break-words min-w-0"><%= account.name %></h1>
  </div>
<% else %>
  <a href="/" class="flex justify-center items-center">
    <span class="mr-3">
      <%= render 'shared/logo', width: '50px', height: '50px' %>
    </span>
    <h1 class="text-5xl font-bold text-center">DocuSeal</h1>
  </a>
<% end %>
